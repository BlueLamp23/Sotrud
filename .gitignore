# ==========================================
# Операционная система
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# IDE и редакторы кода
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# Backend (Go)
# ==========================================
# Бинарные файлы и кэш
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
tmp/

# Go coverage / profiling
*.prof
*.coverprofile
coverage.out
coverage.html
__debug_bin
/backend/server
/backend/cmd/server/server

# ==========================================
# Frontend (Vue / Node.js)
# ==========================================
node_modules/
dist/
build/
.npm
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend cache / coverage
.vite/
.cache/
coverage/
.nyc_output/
*.tsbuildinfo

# ==========================================
# Переменные окружения
# ==========================================
# Игнорируем все .env файлы, кроме примера
.env
.env.*
!.env.example

# ==========================================
# База данных (SQLite)
# ==========================================
# Игнорируем файлы баз данных
*.db
*.sqlite
*.sqlite3
data/*.db

# Игнорируем WAL и SHM файлы, которые SQLite создает при работе
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ==========================================
# Документация и прочее
# ==========================================
~$*.docx
~$*.dotx